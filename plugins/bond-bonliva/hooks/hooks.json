{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/migration-guard.mjs\" || exit 2",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
