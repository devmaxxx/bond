{
  "mcpServers": {
    "bond-atlassian": {
      "type": "sse",
      "url": "https://mcp.atlassian.com/v1/sse"
    },
    "bond-bitbucket": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "bitbucket-mcp-py", "bitbucket-mcp"],
      "env": {
        "BITBUCKET_USERNAME": "${BITBUCKET_USERNAME}",
        "BITBUCKET_TOKEN": "${BITBUCKET_TOKEN}",
        "BITBUCKET_WORKSPACE": "${BITBUCKET_WORKSPACE:-https://bitbucket.org}"
      }
    },
    "bond-clockify": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp_clockify@latest"],
      "env": {
        "CLOCKIFY_API_KEY": "${CLOCKIFY_API_KEY}"
      }
    },
    "bond-teams": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@floriscornel/teams-mcp@latest"]
    },
    "bond-outline": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "--package=outline-mcp-server@latest", "-c", "outline-mcp-server-stdio"],
      "env": {
        "OUTLINE_API_KEY": "${OUTLINE_API_KEY}",
        "OUTLINE_API_URL": "${OUTLINE_API_URL}"
      }
    }
  }
}
